{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VStorage": {
    "BaseUrl": "",
    "BucketName": "vgplanner-attachments",
    "Timeout": "00:10:00",
    "TokenEndpoint": "",
    "ClientId": "vgplanner-api",
    "Audience": "vstorage",
    "Scope": "vstorage-audience"
  },
  "Attachments": {
    "MaxFileSizeBytes": 52428800
  },
  "Authentication": {
    "Authority": "",
    "ClientId": "vgplanner",
    "RequiredRole": "Owner",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  }
}
