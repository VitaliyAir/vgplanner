{
  // Настройки контейнера (ASPNETCORE_ENVIRONMENT=Docker, см. D:\Family\Developer\VDocker). Без секретов: строка
  // подключения и VStorage:ClientSecret приходят из файла .env стека. Миграции применяются при старте (не Production).
  "Authentication": {
    // Издатель так, как его видит браузер; сам API ходит в Keycloak через InternalAuthority.
    "Authority": "http://localhost:8083/realms/VEco",
    "InternalAuthority": "http://host.docker.internal:8083",
    "RequireHttpsMetadata": false
  },
  "VStorage": {
    // Контейнер VStorage в сети стека; token endpoint строится из Authority.
    "BaseUrl": "http://vstorage-api:8080"
  }
}
